# Where the frontend sends API requests.
#
# You normally do not need this file at all:
#
#   npm run dev        -> falls back to http://localhost:8000 (cross-origin,
#                         allowed by the backend's CORS config)
#   npm run build      -> falls back to "" (empty), making every request
#                         relative: /api/calculate
#   docker compose up  -> passes "" explicitly, and nginx proxies /api/ to the
#                         backend container, so the browser stays same-origin
#                         and CORS never applies
#
# Set it only when deploying the built bundle somewhere that is NOT proxying
# /api to the backend for it -- a static host with the API on another domain,
# say. Copy this file to .env.local and edit the value.
#
# Vite inlines this at BUILD time, not at runtime: a container image has the
# value baked in, so it must be set before `npm run build`. That is why the
# Dockerfile takes it as an ARG rather than reading it from the environment
# when the container starts.
VITE_API_URL=http://localhost:8000
